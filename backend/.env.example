# Copy to .env for running outside Docker (npm run start:dev). Docker Compose sets these itself.
DATABASE_URL=postgres://counter:counter@localhost:55432/counter
WEBHOOK_SECRET=dev-webhook-secret
PORT=3000
HOLD_SECONDS=120
EXPIRY_SWEEP_MS=5000

# Used by npm test. Must name a database ending in _test: every test wipes it.
TEST_DATABASE_URL=postgres://counter:counter@localhost:55432/counter_test

# Used by npm run send-webhook
API_URL=http://localhost:3000
